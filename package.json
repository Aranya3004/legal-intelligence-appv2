{
  "name": "legal-intelligence",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "contrast": "node scripts/contrast.mjs",
    "test:track": "tsx scripts/trackchanges.test.ts",
    "test": "npm run typecheck && npm run contrast && npm run test:track && npm run test:a11y && npm run test:api",
    "test:a11y": "vitest run",
    "test:api": "cd backend && python3 -m pytest tests -q -p no:cacheprovider",
    "test:pg": "cd backend && python3 tests/run_postgres.py"
  },
  "dependencies": {
    "@tanstack/react-query": "5.59.0",
    "@tanstack/react-virtual": "^3.10.8",
    "@tiptap/core": "^2.27.3",
    "@tiptap/pm": "^2.27.3",
    "@tiptap/react": "^2.27.3",
    "@tiptap/starter-kit": "^2.27.3",
    "dompurify": "3.1.7",
    "next": "^14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/dompurify": "^3.0.5",
    "@types/jsdom": "^21.1.7",
    "@types/node": "20.16.11",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.10.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.1",
    "typescript": "5.6.3",
    "vitest": "^2.1.3"
  }
}